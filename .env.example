# ============================================================================
# CONFIGURAÇÃO GERAL DO SAAS MULTI-TENANT (DOKPLOY / PRODUÇÃO)
# ============================================================================

# Domínios principais da plataforma (separados por vírgula)
MAIN_DOMAINS=seusistema.com.br,app.seusistema.com.br
CNAME_TARGET=cname.seusistema.com.br
PLATFORM_BASE_URL=https://app.seusistema.com.br

# PostgreSQL (usado pelo docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-em-producao
POSTGRES_DB=ecommerce_saas

# Autenticação JWT (troque por uma string aleatória longa)
SECRET_KEY=troque-por-uma-chave-jwt-forte-e-aleatoria

# Criptografia simétrica de credenciais dos lojistas (Fernet 32-bytes base64)
ENCRYPTION_KEY=GTp1Y_2StR1idjKIEEShehpZXWbAKS3xlXSnom8lAoY=

# Melhor Envio OAuth2 App (opcional)
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_REDIRECT_URI=https://app.seusistema.com.br/api/integrations/melhorenvio/callback

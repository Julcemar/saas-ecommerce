{
    # Configuração global de On-Demand TLS
    # O Caddy consulta o endpoint interno do FastAPI antes de solicitar um certificado Let's Encrypt / ZeroSSL
    on_demand_tls {
        ask http://api:8000/api/internal/verify-domain
        interval 2m
        burst 5
    }
    email admin@seusistema.com.br
}

# 1. Domínio Principal e Subdomínios Wildcard do SaaS
seusistema.com.br, *.seusistema.com.br {
    # Roteia requisições da API para o serviço backend FastAPI
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Roteia todas as outras requisições para o Frontend Next.js
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# 2. Domínios Customizados de Clientes com SSL On-Demand
# Captura qualquer host que aponte o CNAME para cá
:443 {
    tls {
        on_demand
    }

    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# 3. HTTP para redirecionamento automático e desafios ACME
:80 {
    # Permite consulta de validação de domínio em HTTP se necessário
    handle /api/internal/verify-domain* {
        reverse_proxy api:8000
    }

    # Redireciona o tráfego HTTP comum para HTTPS
    handle {
        redir https://{host}{uri} permanent
    }
}
